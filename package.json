{
  "name": "dsh-faremeter",
  "version": "1.3.0",
  "description": "给 AI 对话打表：按 DeepSeek 官方价显示每轮 / 每会话 / 每工作区人民币费用——token 三档 + 峰谷分时，2026-11-01 起网页搜索/抓取按次计费（¥5/1000 次）",
  "license": "MIT",
  "author": "scientificmaniac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scientificmaniac/dsh-faremeter.git"
  },
  "bugs": "https://github.com/scientificmaniac/dsh-faremeter/issues",
  "homepage": "https://github.com/scientificmaniac/dsh-faremeter#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "install-profile.ps1",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "pricing",
    "token-usage",
    "workspace"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "对话打表",
    "description": "给 AI 对话打表：每轮回答的 token 用量旁显示本轮花费，输入框底部显示本会话/全部累计，侧边栏每个工作区显示累计花费。token 三档与峰谷分别计价；2026-11-01 起网页搜索/抓取按次计费（每次 ¥0.005）。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/cost-core.test.mjs && node test/session-scan.test.mjs && node test/client.test.mjs && node test/host.test.mjs",
    "test:live": "node test/live-ledger.mjs",
    "test:vectors": "python test/expected_cost.py --check"
  }
}
